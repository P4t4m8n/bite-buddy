# Copy to .env and fill in the values.

# PostgreSQL (Step 1) — Docker container on 5433 (5432 is taken by the local Windows PostgreSQL service)
DATABASE_URL="postgresql://bitebuddy:bitebuddy@localhost:5433/bitebuddy?schema=public"

# Better Auth (Step 3). BETTER_AUTH_SECRET: any long random string, e.g. npx auth@1.7.22 secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Google Cloud Console OAuth client, redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
