# Copy to .env and fill in the values. On Vercel, set the same variables in
# Project Settings → Environment Variables (with production values).

# PostgreSQL. Local: the Docker container on port 5433 (5432 is used by the local Windows service).
# Neon: use the *pooled* connection string here (host contains "-pooler").
DATABASE_URL="postgresql://bitebuddy:bitebuddy@localhost:5433/bitebuddy?schema=public"
# Neon only: the direct (unpooled) connection string, used by Prisma migrations and the seed.
# Leave empty locally.
DIRECT_URL=""

# Better Auth. BETTER_AUTH_SECRET: any long random string, e.g. npx auth@1.7.22 secret
# (use a different secret in production). BETTER_AUTH_URL: the site's public address.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google Cloud Console OAuth client. Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
